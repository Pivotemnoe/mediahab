{
  "version": 2,
  "serviceWorker": {
    "script": "/sw.js",
    "cacheName": "nagovori-shell-v2",
    "strategy": "shell-get-cache",
    "offlineNavigationFallback": "/offline-notebook.html",
    "shellUrls": [
      "/offline-notebook.html",
      "/manifest.webmanifest",
      "/brand/nagovori-mark.svg",
      "/brand/nagovori-icon.svg",
      "/icons/icon-192.png",
      "/icons/icon-512.png",
      "/icons/icon-maskable-512.png",
      "/icons/apple-touch-icon.png",
      "/icons/favicon-32.png"
    ]
  },
  "capabilities": {
    "backgroundSync": false,
    "mutationReplay": false,
    "offlineNavigationFallback": true
  },
  "replayPolicy": {
    "guidedFormQueue": "manual_retry_required",
    "offlineNotebookQueue": "foreground_idempotent_retry",
    "reason": "http_only_cookie_csrf_required"
  }
}
